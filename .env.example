# Quip Vault Exporter — environment configuration
# Copy to .env and fill in. NEVER commit .env. Tokens live ONLY here, never in config.yml
# or the SQLite state DB.

# Personal/automation token (read-only usage). Get it from https://<your-tenant>/dev/token
QUIP_ACCESS_TOKEN=

# Base URL of your Quip instance. Many tenants use platform.quip.com, but enterprise /
# Salesforce-provisioned tenants may differ. The tool validates the token against this host.
QUIP_BASE_URL=https://platform.quip.com

# --- Optional admin mode (HIGH PRIVILEGE — reads the whole tenant) -----------------------
# Keep the admin token strictly separate from QUIP_ACCESS_TOKEN; it never falls back.
# Requires Admin API enablement on the instance (request via Salesforce/Quip support) and
# the --i-understand-admin-scope flag on the CLI.
QUIP_ADMIN_MODE=false
QUIP_ADMIN_TOKEN=
